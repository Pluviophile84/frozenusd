---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Reserves from '../components/Reserves.astro';
import Idea from '../components/Idea.astro';
import Product from '../components/Product.astro';
import Benefits from '../components/Benefits.astro';
import Satire from '../components/Satire.astro';
import TokenFacts from '../components/TokenFacts.astro';
import Memes from '../components/Memes.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <Reserves />
    <Idea />
    <Product />
    <Benefits />
    <Satire />
    <TokenFacts />
    <Memes />
    <Faq />
    <Closing />
  </main>
  <Footer />
</BaseLayout>
