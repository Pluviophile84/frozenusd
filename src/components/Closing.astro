---
import { site } from '../config/index.ts';
import { closing, actions } from '../content/home.ts';

import Decor from './Decor.astro';

const live = site.token.status === 'live' ? site.token : null;
---

<section class="section closing decorated" aria-labelledby="closing-title">
  <Decor kind="rings" color="var(--ink)" opacity={0.16} style="width: clamp(640px, 82vw, 1180px); left: 50%; top: 50%; transform: translate(-50%, -50%)" />
  <div class="container closing-inner">
    <img class="closing-mark" src="/brand/frozen-usd-reversed.svg" width="64" height="64" alt="" loading="lazy" />
    <h2 id="closing-title">{closing.title}</h2>
    <p class="closing-signature">{closing.signature}</p>
    <div class="closing-actions">
      {
        live ? (
          <a class="btn" href={live.tradeUrl} target="_blank" rel="noopener">
            {actions.buy}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        ) : (
          <a class="btn" href="#token">
            {actions.coldFacts}
          </a>
        )
      }
      {
        site.social.xUrl && (
          <a class="btn btn--secondary" href={site.social.xUrl} target="_blank" rel="noopener">
            {actions.followX}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        )
      }
    </div>
    <p class="sign-off">{closing.signOff}</p>
  </div>
</section>

<style>
  /* The logo's glacial cyan, with a soft light source and depth at the edges. */
  .closing {
    background:
      radial-gradient(60% 55% at 50% 0%, rgb(255 255 255 / 0.45) 0%, rgb(255 255 255 / 0) 70%),
      radial-gradient(80% 70% at 50% 120%, rgb(0 85 112 / 0.22) 0%, rgb(0 85 112 / 0) 70%),
      var(--cyan);
    color: var(--ink);
    text-align: center;
  }

  .closing-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .closing-mark {
    width: 56px;
    height: 56px;
    margin-bottom: 32px;
  }

  .closing h2 {
    max-width: 14ch;
    font-size: clamp(2.375rem, 1.4rem + 3.6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .closing-signature {
    margin-top: 22px;
    font-size: var(--text-lead);
    font-weight: 800;
    color: var(--ink);
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  .sign-off {
    margin-top: 56px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .sign-off::before {
    content: '';
    display: block;
    width: 1px;
    height: 40px;
    margin: 0 auto 16px;
    background: rgb(7 24 39 / 0.35);
  }
</style>
