---
import { reserves } from '../content/home.ts';
import Cube from './Cube.astro';
---

<section class="section reserves on-ink" id="reserves" aria-labelledby="reserves-title">
  <div class="container">
    <div class="reserves-grid">
      <div class="reserves-intro">
        <p class="eyebrow reserves-eyebrow">{reserves.eyebrow}</p>
        <h2 id="reserves-title">{reserves.title}</h2>
        <p class="reserves-body">{reserves.body}</p>
      </div>
      <div class="reserves-unit" aria-hidden="true">
        <Cube sizes="(min-width: 900px) 340px, 52vw" widths={[320, 640, 960]} />
      </div>
    </div>

    <dl class="reserve-facts">
      {
        reserves.facts.map((fact) => (
          <div class="reserve-fact">
            <dt>{fact.label}</dt>
            <dd class="reserve-value">{fact.value}</dd>
            <dd class="reserve-line">{fact.line}</dd>
          </div>
        ))
      }
    </dl>

    <div class="reserves-close">
      <h3>{reserves.subtitle}</h3>
      <div>
        <p class="reserves-text">{reserves.text}</p>
        <p class="reserves-small">{reserves.small}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .reserves {
    position: relative;
    background:
      radial-gradient(55% 60% at 82% 18%, rgb(121 218 255 / 0.12) 0%, rgb(121 218 255 / 0) 70%),
      var(--ink);
    color: var(--white);
    overflow: hidden;
  }

  .reserves-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px clamp(48px, 6vw, 96px);
  }

  .reserves-eyebrow {
    color: var(--cyan);
  }

  .reserves h2 {
    margin-top: 18px;
    max-width: 14ch;
    color: var(--white);
    font-size: clamp(2.5rem, 1.5rem + 4vw, 5.25rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .reserves-body {
    margin-top: 28px;
    max-width: 38rem;
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--on-ink-muted);
  }

  .reserves-unit {
    position: relative;
    justify-self: center;
    width: min(100%, 340px);
  }

  .reserves-unit::before {
    content: '';
    position: absolute;
    inset: 8% 4% -2%;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(121 218 255 / 0.22), rgb(121 218 255 / 0));
  }

  .reserves-unit :global(.cube) {
    position: relative;
    width: 100%;
  }

  .reserve-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(56px, 7vw, 96px) 0 0;
    border-top: 1px solid var(--ink-rule);
    border-bottom: 1px solid var(--ink-rule);
  }

  .reserve-fact {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 32px clamp(16px, 2.6vw, 40px) 34px;
  }

  .reserve-fact:first-child {
    padding-left: 0;
  }

  .reserve-fact + .reserve-fact {
    border-left: 1px solid var(--ink-rule);
  }

  .reserve-fact dt {
    order: 2;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .reserve-value {
    order: 1;
    margin-bottom: 10px;
    font-size: clamp(2.75rem, 1.9rem + 2.8vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--white);
  }

  .reserve-line {
    order: 3;
    font-size: 1rem;
    color: var(--on-ink-muted);
  }

  .reserves-close {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px clamp(48px, 6vw, 96px);
    align-items: start;
    margin-top: clamp(40px, 5vw, 56px);
  }

  .reserves-close h3 {
    color: var(--white);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    letter-spacing: -0.025em;
  }

  .reserves-text {
    font-size: 1.0625rem;
    color: var(--white);
  }

  .reserves-small {
    margin-top: 10px;
    font-size: 0.875rem;
    color: var(--on-ink-muted);
  }

  @media (max-width: 899px) {
    .reserves-grid,
    .reserves-close {
      grid-template-columns: minmax(0, 1fr);
    }

    .reserves-unit {
      justify-self: start;
      width: min(52vw, 240px);
    }

    .reserve-facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .reserve-fact,
    .reserve-fact:first-child {
      padding: 24px 0;
    }

    .reserve-fact + .reserve-fact {
      border-left: 0;
      border-top: 1px solid var(--ink-rule);
    }
  }
</style>
