---
/**
 * Hero artwork: one stationary Frozen USD cube with three cubes on an outer
 * ring (clockwise) and eight on an inner ring (counter-clockwise), each one
 * revolution per 100 s. Every orbiting cube sits in nested transforms:
 *   carrier (rotates about the centre) → arm (fixed offset to the radius)
 *   → upright (counter-rotates by exactly the carrier's angle) → image.
 * Net orientation stays constant, so every cube stays upright.
 * Reduced motion and no-animation states show the same composition at rest.
 */
import Cube from './Cube.astro';
import { hero } from '../content/home.ts';

const outer = [0, 120, 240];
const inner = [0, 45, 90, 135, 180, 225, 270, 315];

// Guide geometry on a 1000-unit square (scene width S = 1000).
const R_OUTER = 420;
const R_INNER = 250;
const R_LOBE = R_OUTER / 2;
const lobes = [0, 120, 240].map((deg) => {
  const rad = (deg * Math.PI) / 180;
  return { cx: 500 + R_LOBE * Math.sin(rad), cy: 500 - R_LOBE * Math.cos(rad) };
});

// All orbiting copies share one rendered size hint, so they share one file.
const orbitSizes = '(min-width: 600px) 76px, 14vw';
---

<div class="orbit" data-orbit>
  <input class="motion-switch" type="checkbox" id="orbit-pause" role="switch" />
  <label class="motion-label" for="orbit-pause">
    <span class="motion-track" aria-hidden="true"><span class="motion-thumb"></span></span>
    Pause movement
  </label>

  <div class="orbit-scene" role="img" aria-label={hero.art.alt}>
    <svg class="orbit-guides" viewBox="0 0 1000 1000" width="1000" height="1000" aria-hidden="true" focusable="false">
      <g fill="none" stroke-linecap="round" vector-effect="non-scaling-stroke">
        {
          lobes.map((lobe) => (
            <circle class="guide guide--lobe" cx={lobe.cx.toFixed(2)} cy={lobe.cy.toFixed(2)} r={R_LOBE} />
          ))
        }
        <circle class="guide guide--inner" cx="500" cy="500" r={R_INNER}></circle>
        <circle class="guide guide--outer" cx="500" cy="500" r={R_OUTER}></circle>
      </g>
    </svg>

    <div class="orbit-rings" aria-hidden="true">
      {
        outer.map((phase) => (
          <div class="carrier carrier--outer" style={`--phase: ${phase}deg`}>
            <div class="arm">
              <div class="upright">
                <Cube class="orbit-cube" sizes={orbitSizes} widths={[160, 320]} />
              </div>
            </div>
          </div>
        ))
      }
      {
        inner.map((phase) => (
          <div class="carrier carrier--inner" style={`--phase: ${phase}deg`}>
            <div class="arm">
              <div class="upright">
                <Cube class="orbit-cube" sizes={orbitSizes} widths={[160, 320]} />
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="orbit-center" aria-hidden="true">
      <Cube class="center-cube" sizes="(min-width: 600px) 162px, 30vw" widths={[320, 640]} loading="eager" fetchpriority="high" />
    </div>
  </div>
</div>

<style>
  .orbit {
    --period: 100s;
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 540px;
    margin-inline: auto;
    container-type: inline-size;
  }

  .orbit-scene {
    order: 1;
    /* Scene width S = 100cqw. Proportions are fractions of S. */
    --r-outer: 42cqw;
    --r-inner: 25cqw;
    --size-center: 30cqw;
    --size-outer: 14cqw;
    --size-inner: 9.5cqw;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
  }

  .orbit-guides {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .guide {
    stroke-width: 1.25;
  }

  .guide--outer,
  .guide--inner {
    stroke: #7fa6bb;
    stroke-opacity: 0.55;
    stroke-dasharray: 2 7;
  }

  .guide--lobe {
    stroke: #79daff;
    stroke-opacity: 0.75;
    stroke-dasharray: 1 6;
  }

  .orbit-rings {
    position: absolute;
    inset: 0;
  }

  /* 1. Carrier: a zero-size point at the scene centre that rotates. */
  .carrier {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform: rotate(var(--phase));
  }

  /* 2. Arm: a fixed offset out to the ring radius (never animated). */
  .arm {
    position: absolute;
    left: 0;
    top: 0;
  }

  .carrier--outer .arm {
    transform: translateY(calc(var(--r-outer) * -1));
    --size: var(--size-outer);
  }

  .carrier--inner .arm {
    transform: translateY(calc(var(--r-inner) * -1));
    --size: var(--size-inner);
  }

  /* 3. Upright: counter-rotates by the carrier's complete angle. */
  .upright {
    position: absolute;
    left: 0;
    top: 0;
    transform: rotate(calc(var(--phase) * -1));
  }

  /* 4. The complete cube image, centred on the orbit point. */
  .upright :global(.orbit-cube) {
    position: absolute;
    left: calc(var(--size) / -2);
    top: calc(var(--size) / -2);
    width: var(--size);
    max-width: none;
  }

  .orbit-center {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--size-center);
    transform: translate(-50%, -50%);
  }

  .orbit-center :global(.center-cube) {
    width: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .carrier--outer {
      animation: orbit-cw var(--period) linear infinite;
    }

    .carrier--outer .upright {
      animation: upright-cw var(--period) linear infinite;
    }

    .carrier--inner {
      animation: orbit-ccw var(--period) linear infinite;
    }

    .carrier--inner .upright {
      animation: upright-ccw var(--period) linear infinite;
    }

    .orbit-rings,
    .orbit-guides {
      animation: orbit-enter 1.1s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }

    /* One switch pauses every carrier and counter-rotation together. */
    .motion-switch:checked ~ .orbit-scene :is(.carrier, .upright),
    .orbit:global(.is-offscreen) :is(.carrier, .upright),
    .orbit:global(.is-hidden) :is(.carrier, .upright) {
      animation-play-state: paused;
    }
  }

  @keyframes orbit-cw {
    from {
      transform: rotate(var(--phase));
    }
    to {
      transform: rotate(calc(var(--phase) + 360deg));
    }
  }

  @keyframes upright-cw {
    from {
      transform: rotate(calc(var(--phase) * -1));
    }
    to {
      transform: rotate(calc(var(--phase) * -1 - 360deg));
    }
  }

  @keyframes orbit-ccw {
    from {
      transform: rotate(var(--phase));
    }
    to {
      transform: rotate(calc(var(--phase) - 360deg));
    }
  }

  @keyframes upright-ccw {
    from {
      transform: rotate(calc(var(--phase) * -1));
    }
    to {
      transform: rotate(calc(var(--phase) * -1 + 360deg));
    }
  }

  @keyframes orbit-enter {
    from {
      opacity: 0.35;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Pause switch: a native checkbox, so it works without JavaScript. */
  .motion-switch {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  /* Sits below the scene (visual order), never over an orbiting cube. */
  .motion-label {
    order: 2;
    align-self: flex-end;
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 6px;
    border-radius: var(--radius-control);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
    user-select: none;
  }

  .motion-label:hover {
    color: var(--ink);
  }

  .motion-track {
    position: relative;
    width: 32px;
    height: 18px;
    border-radius: 9px;
    background: #b8cfdc;
    transition: background-color 160ms var(--ease-out);
  }

  .motion-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 1px 2px rgb(7 24 39 / 0.3);
    transition: transform 160ms var(--ease-out);
  }

  .motion-switch:checked + .motion-label {
    color: var(--ink);
  }

  .motion-switch:checked + .motion-label .motion-track {
    background: var(--ink);
  }

  .motion-switch:checked + .motion-label .motion-thumb {
    transform: translateX(14px);
  }

  .motion-switch:focus-visible + .motion-label {
    outline: 3px solid var(--interactive);
    outline-offset: 0;
  }

  /* Nothing moves: no pause control needed. */
  @media (prefers-reduced-motion: reduce) {
    .motion-label {
      display: none;
    }
  }
</style>

<script>
  import { initOrbitMotion } from '../scripts/motion.ts';
  initOrbitMotion('[data-orbit]');
</script>
