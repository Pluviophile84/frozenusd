---
/**
 * Hero product composition: the frozen coin travels between two abstract
 * wallets without thawing. The resting (and reduced-motion) state shows the
 * block arrived at Wallet B, with the empty slot and route at Wallet A, so the
 * idea reads without animation or JavaScript.
 */
import { iceBlockSvg, iceShadowSvg } from '../lib/ice-block.ts';
import { hero } from '../content/home.ts';

const W = 620;
const H = 560;
const padY = 446;
const padA = 156;
const padB = 456;
const scale = 1.1;
const blockX = padB - 121 * scale;
const blockY = padY - 32 - 200 * scale;

const pct = (value: number, total: number) => `${((value / total) * 100).toFixed(2)}%`;
---

<figure class="hero-art" aria-labelledby="hero-art-caption">
  <figcaption id="hero-art-caption" class="visually-hidden">{hero.art.alt}</figcaption>

  <input class="motion-switch" type="checkbox" id="hero-motion" role="switch" />
  <label class="motion-label" for="hero-motion">
    <span class="motion-track" aria-hidden="true"><span class="motion-thumb"></span></span>
    Pause movement
  </label>

  <div class="stage">
    <div class="canvas">
    <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="pad-top" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.95"></stop>
          <stop offset="1" stop-color="#EAF6FC" stop-opacity="0.95"></stop>
        </linearGradient>
        <linearGradient id="pad-side" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#BFE2F1"></stop>
          <stop offset="0.5" stop-color="#D9EFF8"></stop>
          <stop offset="1" stop-color="#A9D6EA"></stop>
        </linearGradient>
        <marker id="route-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M1 1 L7 5 L1 9" fill="none" stroke="#005570" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </marker>
      </defs>

      {
        [padA, padB].map((x) => (
          <g class="pad">
            <path
              d={`M ${x - 116} ${padY} v 12 a 116 26 0 0 0 232 0 v -12`}
              fill="url(#pad-side)"
              stroke="#A3CDE0"
              stroke-width="1"
            />
            <ellipse cx={x} cy={padY} rx="116" ry="26" fill="url(#pad-top)" stroke="#A3CDE0" stroke-width="1" />
            <ellipse cx={x} cy={padY} rx="84" ry="17" fill="none" stroke="#005570" stroke-opacity="0.35" stroke-dasharray="4 5" />
          </g>
        ))
      }

      <!-- Route between the wallets. -->
      <path
        d={`M ${padA + 30} ${padY - 34} Q ${(padA + padB) / 2} ${padY - 120} ${padB - 70} ${padY - 40}`}
        fill="none"
        stroke="#005570"
        stroke-opacity="0.55"
        stroke-width="1.5"
        stroke-dasharray="2 6"
        stroke-linecap="round"
        marker-end="url(#route-arrow)"></path>

      <path class="route-signal" d={`M ${padA + 30} ${padY - 34} Q ${(padA + padB) / 2} ${padY - 120} ${padB - 70} ${padY - 40}`} pathLength="1" fill="none" stroke="#2798BE" stroke-width="3" stroke-linecap="round" stroke-dasharray=".16 1" />
      <ellipse class="arrival-ring" cx={padA} cy={padY} rx="103" ry="23" fill="none" stroke="#79DAFF" stroke-width="2" />
      <!-- Quiet departure imprint; the solid object carries the visual weight. -->
      <g class="ghost" transform={`translate(${padA - 121 * scale} ${blockY}) scale(${scale})`}>
        <polygon
          points="0,0 42,-32 242,-32 242,168 200,200 0,200"
          fill="#FFFFFF"
          fill-opacity="0.05"
          stroke="#005570"
          stroke-opacity="0.12"
          stroke-dasharray="5 6"></polygon>
      </g>

      <g class="mover">
        <g class="lift-shadow" style={`transform-origin: ${padB}px ${padY}px`}>
          <Fragment set:html={iceShadowSvg('hero-shadow', padB, padY + 2, 250)} />
        </g>
        <g class="hop">
          <g transform={`translate(${blockX} ${blockY}) scale(${scale})`}>
            <Fragment set:html={iceBlockSvg('hero-ice', 'full')} />
          </g>
        </g>
      </g>
    </svg>

    <p class="art-tag art-tag--caption" aria-hidden="true">{hero.art.label}</p>
    <p class="art-tag art-tag--wallet" style={`left: ${pct(padA, W)}; top: ${pct(padY + 52, H)}`} aria-hidden="true">Wallet A</p>
    <p class="art-tag art-tag--wallet" style={`left: ${pct(padB, W)}; top: ${pct(padY + 52, H)}`} aria-hidden="true">Wallet B</p>
    </div>
    <ul class="art-readout" aria-hidden="true">
      <li><span class="dot dot--location"></span>{hero.art.location}</li>
      <li><span class="dot dot--temp"></span>{hero.art.temperature}</li>
    </ul>
  </div>
</figure>

<style>
  .hero-art {
    position: relative;
    margin: 0;
  }

  .stage {
    position: relative;
    border: 1px solid rgb(164 199 217 / 0.48);
    border-radius: var(--radius-material);
    background:
      radial-gradient(ellipse at 60% 46%, #ffffff 0%, #edf8fd 40%, transparent 72%),
      linear-gradient(145deg, #f6fbfe 0%, #d5eaf4 100%);
    box-shadow: inset 0 1px 0 #fff, 0 32px 64px -40px rgb(22 74 103 / 0.32);
    overflow: hidden;
    isolation: isolate;
  }

  /* Broad diffused light keeps the stage quiet behind the material. */
  .stage::before {
    content: '';
    position: absolute;
    inset: 16% -20% -45%;
    z-index: -1;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.7);
    box-shadow: 0 0 0 48px rgb(255 255 255 / 0.14), 0 0 0 96px rgb(255 255 255 / 0.1);
    transform: rotate(-24deg);
  }

  svg {
    width: 100%;
    height: auto;
  }

  .art-tag {
    position: absolute;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .art-tag--caption {
    top: 22px;
    left: 24px;
    text-transform: uppercase;
  }

  .canvas {
    position: relative;
    transform: perspective(1100px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform 650ms cubic-bezier(.16, 1, .3, 1);
  }

  .route-signal { opacity: 0; }
  .arrival-ring { opacity: 0; transform-box: fill-box; transform-origin: center; }

  .art-tag--wallet {
    transform: translateX(-50%);
    color: var(--ink);
    font-weight: 600;
  }

  .art-readout {
    position: absolute;
    top: 64px;
    left: 24px;
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    justify-items: end;
  }

  .art-readout li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 12px;
    background: rgb(255 255 255 / 0.88);
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    box-shadow: var(--shadow-soft);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--ink);
    white-space: nowrap;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot--location {
    border: 1.5px solid var(--interactive);
  }

  .dot--temp {
    background: var(--cyan);
    box-shadow: 0 0 0 3px rgb(121 218 255 / 0.35);
  }

  /* Pause switch: a native checkbox, so it works without JavaScript. */
  .motion-switch {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .motion-label {
    position: absolute;
    z-index: 2;
    top: 10px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 10px;
    border-radius: var(--radius-control);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    user-select: none;
  }

  .motion-track {
    position: relative;
    width: 32px;
    height: 18px;
    border-radius: 9px;
    background: #b8cfdc;
    transition: background-color 160ms var(--ease-out);
  }

  .motion-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 1px 2px rgb(7 24 39 / 0.3);
    transition: transform 160ms var(--ease-out);
  }

  .motion-switch:checked + .motion-label .motion-track {
    background: var(--ink);
  }

  .motion-switch:checked + .motion-label .motion-thumb {
    transform: translateX(14px);
  }

  .motion-switch:focus-visible + .motion-label {
    outline: 3px solid var(--interactive);
    outline-offset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mover {
      animation: travel-x 10s infinite both;
    }

    .hop {
      animation: travel-y 10s infinite both;
      transform-origin: 456px 405px;
    }

    .lift-shadow {
      animation: travel-shadow 10s infinite both;
    }

    .route-signal { animation: route-flow 10s linear infinite both; }
    .arrival-ring { animation: arrival 10s infinite both; }

    .motion-switch:checked ~ .stage :is(.mover, .hop, .lift-shadow, .route-signal, .arrival-ring),
    .hero-art:global(.is-offscreen) :is(.mover, .hop, .lift-shadow, .route-signal, .arrival-ring) {
      animation-play-state: paused;
    }
  }

  /* Nothing moves: no pause control needed. */
  @media (prefers-reduced-motion: reduce) {
    .motion-label {
      display: none;
    }
  }

  @keyframes travel-x {
    0%, 12% { transform: translateX(0); animation-timing-function: cubic-bezier(.65, 0, .2, 1); }
    42%, 62% { transform: translateX(-300px); animation-timing-function: cubic-bezier(.65, 0, .2, 1); }
    92%, 100% { transform: translateX(0); }
  }

  @keyframes travel-y {
    0%, 12%, 42%, 62%, 92%, 100% { transform: translateY(0) rotate(0); animation-timing-function: ease-in-out; }
    27% { transform: translateY(-46px) rotate(-5deg); animation-timing-function: ease-in-out; }
    77% { transform: translateY(-46px) rotate(5deg); animation-timing-function: ease-in-out; }
  }

  @keyframes travel-shadow {
    0%, 12%, 42%, 62%, 92%, 100% { transform: scale(1); opacity: .9; }
    27%, 77% { transform: scale(.72); opacity: .35; }
  }

  @keyframes route-flow {
    0%, 12% { stroke-dashoffset: -1; opacity: 0; }
    16% { opacity: .7; }
    42% { stroke-dashoffset: 0; opacity: 0; }
    62% { stroke-dashoffset: 0; opacity: 0; }
    66% { opacity: .7; }
    92%, 100% { stroke-dashoffset: -1; opacity: 0; }
  }

  @keyframes arrival {
    0%, 39%, 58%, 100% { opacity: 0; transform: scale(.75); }
    43% { opacity: .8; transform: scale(.85); }
    56% { opacity: 0; transform: scale(1.35); }
  }

  @media (max-width: 559px) {
    .art-tag--caption {
      top: 16px;
      left: 16px;
    }

    .motion-label {
      top: 4px;
      right: 4px;
    }

    .art-readout {
      position: static;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
      padding: 0 12px 16px;
    }

    .art-readout li {
      padding: 5px 9px;
      font-size: 0.6875rem;
    }

    .art-tag--wallet {
      font-size: 0.6875rem;
    }
  }
  @media (max-width: 359px) {
    .art-tag--caption { max-width: 82px; }
  }
</style>

<script>
  import { initMotionVisibility } from '../scripts/motion.ts';
  initMotionVisibility('.hero-art');
</script>
