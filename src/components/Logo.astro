---
import { site } from '../config/index.ts';

interface Props {
  href?: string;
  /** Text colour of the wordmark. The official logo file is the same on both. */
  tone?: 'light' | 'dark';
  size?: number;
}
const { href = '/', tone = 'light', size = 34 } = Astro.props;
const src = '/brand/frozenusd-b-rim.svg';
---

<a class:list={['logo', `logo--${tone}`]} href={href}>
  <img src={src} width={size} height={size} alt="" />
  <span class="logo-text">{site.brand.name}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo:hover {
    color: var(--ink);
  }

  .logo--dark,
  .logo--dark:hover {
    color: var(--white);
  }

  .logo-text {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }
</style>
